<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<title>MI@MI</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#160A2E;--bg2:#0D0620;--card:rgba(13,6,32,.72);--line:#3A2366;--txt:#F7EEFF;--mut:#C9B8E6;--cyan:#19E3D0;--pink:#FF3E9A;--orange:#FF8A3D;--yellow:#FFE27A}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--txt);font-family:'Manrope','Inter',system-ui,sans-serif;overflow-x:hidden}
button{font-family:inherit;cursor:pointer;color:inherit}
.anton{font-family:'Anton','Inter Display','Inter',sans-serif;font-weight:900;letter-spacing:1px}
.page{display:none;min-height:100vh;padding-bottom:120px}
.page.on{display:block}
.wrap{max-width:560px;margin:0 auto;padding:0 14px}

/* HERO */
.hero{position:relative;height:92vh;min-height:560px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.glow{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none}
.grid{position:absolute;left:-50%;right:-50%;bottom:-6%;height:30%;background-image:linear-gradient(rgba(255,62,154,.55) 2px,transparent 2px),linear-gradient(90deg,rgba(255,62,154,.55) 2px,transparent 2px);background-size:60px 60px;transform:perspective(320px) rotateX(62deg);transform-origin:bottom;animation:floor 2.4s linear infinite;mask-image:linear-gradient(to top,#000 30%,transparent)}
@keyframes floor{to{background-position:0 60px}}
.horizon{position:absolute;left:0;right:0;bottom:24%;height:3px;background:var(--cyan);box-shadow:0 0 18px var(--cyan)}
.badge-live{position:absolute;top:16px;left:16px;display:flex;align-items:center;gap:8px;font-size:11px;font-weight:800;letter-spacing:3px;color:var(--cyan)}
.badge-live i{width:8px;height:8px;border-radius:50%;background:var(--pink);box-shadow:0 0 10px var(--pink);animation:blink 1.4s infinite}
@keyframes blink{50%{opacity:.25}}
.kicker{font-size:11px;font-weight:800;letter-spacing:6px;color:var(--cyan)}
.big{font-size:min(26vw,150px);line-height:.95;margin:14px 0 6px;color:var(--txt);text-shadow:5px 5px 0 var(--cyan),10px 10px 0 var(--pink);animation:flick 6s infinite}
@keyframes flick{0%,93%,100%{opacity:1}94%{opacity:.6}96%{opacity:1}97%{opacity:.75}}
.sub{font-size:11px;font-weight:800;letter-spacing:7px;color:var(--txt);opacity:.85}
.explorer{margin-top:28px;display:inline-flex;align-items:center;gap:0;border:none;border-radius:999px;overflow:hidden;background:var(--pink);box-shadow:0 0 30px rgba(255,62,154,.55)}
.explorer span{padding:15px 26px;font-weight:800;font-size:13px;letter-spacing:4px;color:#fff}
.explorer b{padding:15px 16px;background:#0D0620;color:var(--pink);font-size:15px}
.defiler{position:absolute;bottom:22px;left:0;right:0;font-size:10px;font-weight:800;letter-spacing:4px;color:var(--mut);animation:bob 2s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(6px)}}
.bill{position:absolute;top:-60px;animation:fall linear infinite;opacity:.9}
@keyframes fall{to{transform:translateY(110vh) rotate(540deg)}}

/* ACCUEIL */
.welcome{display:flex;align-items:center;gap:12px;padding:18px 0 12px;border-bottom:1.5px solid var(--line)}
.av{width:46px;height:46px;border-radius:50%;border:2px solid var(--cyan);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--cyan);box-shadow:0 0 14px rgba(25,227,208,.35)}
.lbl{font-size:10px;font-weight:800;letter-spacing:4px;color:var(--cyan)}
.lbl::before{content:"● ";color:var(--pink)}
.hello{font-size:24px;font-weight:800;margin-top:2px}
.pill{display:inline-block;padding:5px 12px;border-radius:999px;font-size:11px;font-weight:800;background:rgba(255,226,122,.12);color:var(--yellow);border:1px solid rgba(255,226,122,.4)}
.chips{display:flex;gap:8px;overflow-x:auto;padding:12px 0 14px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;height:38px;padding:0 16px;border-radius:12px;border:1.5px solid var(--line);background:var(--card);font-weight:700;font-size:13px}
.chip.on{background:var(--cyan);border-color:var(--cyan);color:#0D0620}
.gridp{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.pc{background:var(--card);border:1.5px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;text-align:left;padding:0}
.pm{position:relative;aspect-ratio:1/1;background:#22103F;overflow:hidden}
.pm img,.pm video{width:100%;height:100%;object-fit:cover;display:block}
.ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:44px}
.tag{position:absolute;left:8px;bottom:8px;padding:4px 9px;border-radius:999px;font-size:9px;font-weight:800;letter-spacing:1.5px;background:rgba(13,6,32,.85);border:1px solid}
.vid{position:absolute;right:8px;top:8px;width:26px;height:26px;border-radius:50%;background:rgba(13,6,32,.8);display:flex;align-items:center;justify-content:center}
.pi{padding:10px 11px 11px;display:flex;flex-direction:column;gap:3px;flex:1}
.pn{font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.3px;line-height:1.25}
.pd{font-size:11px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pb{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:6px}
.pp{font-size:17px}
.plus{width:34px;height:34px;border-radius:50%;border:none;background:var(--cyan);color:#0D0620;font-size:20px;font-weight:800;display:flex;align-items:center;justify-content:center}
.qn{min-width:34px;height:34px;padding:0 10px;border-radius:999px;background:var(--pink);color:#fff;font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center}
.msg{padding:40px 10px;text-align:center;color:var(--mut);font-size:14px}

/* SECTIONS */
.head{display:flex;align-items:center;gap:12px;padding:22px 0 14px;border-bottom:1.5px solid var(--line);margin-bottom:14px}
.hi{width:40px;height:40px;border-radius:12px;border:1.5px solid var(--cyan);display:flex;align-items:center;justify-content:center;color:var(--cyan)}
.ht{font-size:26px}
.box{background:var(--card);border:1.5px solid var(--line);border-radius:16px;padding:16px;margin-bottom:12px}
.bt{display:flex;align-items:center;gap:10px;font-weight:800;font-size:16px}
.bi{width:36px;height:36px;border-radius:10px;background:rgba(25,227,208,.1);border:1px solid rgba(25,227,208,.4);display:flex;align-items:center;justify-content:center;color:var(--cyan);flex:none}
.bx{font-size:13px;color:var(--mut);margin-top:10px;line-height:1.5}
.row{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.03);border:1px solid var(--line);margin-top:8px;font-size:14px;font-weight:700}
.row span:last-child{color:var(--cyan)}
.right{display:flex;justify-content:flex-end;margin-top:10px}

/* PANIER */
.empty{text-align:center;padding:50px 20px}
.ei{width:70px;height:70px;margin:0 auto 18px;border-radius:20px;border:1.5px solid var(--pink);display:flex;align-items:center;justify-content:center;color:var(--pink);box-shadow:0 0 24px rgba(255,62,154,.35)}
.cta{height:52px;padding:0 26px;border-radius:14px;border:none;background:var(--pink);color:#fff;font-weight:800;font-size:15px;letter-spacing:.5px;box-shadow:0 0 22px rgba(255,62,154,.4)}
.cta.full{width:100%}
.line{display:flex;align-items:center;gap:10px;padding:10px;background:var(--card);border:1.5px solid var(--line);border-radius:14px;margin-bottom:8px}
.lt{width:52px;height:52px;border-radius:10px;overflow:hidden;flex:none;background:#22103F}
.lt img{width:100%;height:100%;object-fit:cover}
.lx{flex:1;min-width:0}
.ln{font-weight:800;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ls{font-size:12px;color:var(--mut);margin-top:2px}
.step{display:flex;align-items:center;gap:8px}
.sb{width:34px;height:34px;border-radius:50%;font-size:18px;font-weight:800;display:flex;align-items:center;justify-content:center}
.sb.m{border:1.5px solid var(--pink);background:transparent;color:var(--pink)}
.sb.p{border:none;background:var(--cyan);color:#0D0620}
.toggle{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0 10px}
.tg{height:48px;border-radius:12px;border:1.5px solid var(--line);background:var(--card);font-weight:800;font-size:14px}
.tg.on{border-color:var(--cyan);color:var(--cyan);background:rgba(25,227,208,.08)}
label.f{display:block;font-size:11px;font-weight:800;letter-spacing:2px;color:var(--mut);margin:12px 0 6px}
input.f,textarea.f{width:100%;border-radius:12px;border:1.5px solid var(--line);background:var(--bg2);color:var(--txt);font:inherit;font-size:15px;padding:12px}
textarea.f{min-height:70px;resize:vertical}
input.f:focus,textarea.f:focus{outline:none;border-color:var(--cyan)}
.err{color:#FF7AA8;font-size:13px;font-weight:700;margin-top:8px;min-height:18px}
.tot{display:flex;justify-content:space-between;align-items:baseline;padding:14px 2px}
.tot span:first-child{font-size:12px;font-weight:800;letter-spacing:3px;color:var(--mut)}
.tot span:last-child{font-size:30px;color:var(--yellow)}
.note{font-size:12px;color:var(--mut);text-align:center;margin-top:10px;line-height:1.5}

/* CONTACT */
.cl{display:flex;align-items:center;gap:12px;width:100%;padding:14px;margin-bottom:10px;background:var(--card);border:1.5px solid var(--line);border-radius:16px;text-align:left;text-decoration:none;color:var(--txt)}
.cl small{display:block;font-size:10px;font-weight:800;letter-spacing:3px}
.cl b{font-size:16px}
.cl .go{margin-left:auto;color:var(--mut)}

/* NAV */
nav{position:fixed;left:10px;right:10px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:20;max-width:540px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);background:rgba(13,6,32,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1.5px solid var(--line);border-radius:22px;padding:8px 6px}
nav button{background:none;border:none;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10px;font-weight:700;color:var(--mut);position:relative;padding:4px 0}
nav button .ic{width:38px;height:32px;border-radius:12px;display:flex;align-items:center;justify-content:center}
nav button.on{color:var(--cyan)}
nav button.on .ic{background:rgba(25,227,208,.12);box-shadow:0 0 0 1.5px var(--cyan),0 0 16px rgba(25,227,208,.35)}
.cnt{position:absolute;top:0;right:calc(50% - 26px);min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:var(--pink);color:#fff;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center}

/* FICHE PRODUIT */
.sheet{position:fixed;inset:0;z-index:40;display:none}
.sheet.on{display:block}
.shade{position:absolute;inset:0;background:rgba(5,2,14,.7)}
.panel{position:absolute;left:0;right:0;bottom:0;max-width:560px;margin:0 auto;max-height:92vh;overflow-y:auto;background:var(--bg);border:1.5px solid var(--line);border-bottom:none;border-radius:24px 24px 0 0;animation:up .25s ease-out;padding-bottom:calc(16px + env(safe-area-inset-bottom))}
@keyframes up{from{transform:translateY(40px);opacity:.4}}
.sm{position:relative;aspect-ratio:4/3;background:#22103F}
.sm img,.sm video{width:100%;height:100%;object-fit:cover;display:block}
.close{position:absolute;top:12px;right:12px;width:38px;height:38px;border-radius:50%;border:none;background:rgba(13,6,32,.8);font-size:18px;color:#fff}
.sc{padding:16px 16px 0}
.sn{font-size:30px;line-height:1.05;margin:8px 0}
.sd{font-size:14px;color:var(--mut);line-height:1.5}
.sa{display:flex;align-items:center;justify-content:space-between;margin:18px 0 14px}
.sa .anton{font-size:28px;color:var(--yellow)}
.toast{position:fixed;left:50%;bottom:110px;transform:translateX(-50%);z-index:50;padding:10px 16px;border-radius:999px;background:var(--cyan);color:#0D0620;font-weight:800;font-size:13px;opacity:0;transition:opacity .2s;pointer-events:none;white-space:nowrap}
.toast.on{opacity:1}
</style>
</head>
<body>

<!-- ACCUEIL -->
<section class="page on" id="p-accueil">
  <div class="hero" id="hero">
    <div class="glow" style="width:320px;height:320px;left:-120px;top:-80px;background:#FF2E4D;opacity:.5"></div>
    <div class="glow" style="width:320px;height:320px;right:-120px;top:-60px;background:#2E6BFF;opacity:.5"></div>
    <div class="glow" style="width:300px;height:300px;left:50%;margin-left:-150px;bottom:20%;background:#FF3E9A;opacity:.28"></div>
    <div class="grid"></div>
    <div class="horizon"></div>
    <div id="bills"></div>
    <div class="badge-live"><i></i>EN LIGNE</div>
    <div style="position:relative;z-index:2;padding:0 16px">
      <div class="kicker">MIAMI VIBES · MONEY TALKS</div>
      <div class="big anton">MI@MI</div>
      <div class="sub">FIVESTARS ★★★★★</div>
      <button class="explorer" id="go-explorer" type="button"><span>EXPLORER</span><b>↗</b></button>
    </div>
    <div class="defiler">⌄<br>DÉFILER</div>
  </div>

  <div class="wrap" id="catalogue">
    <div class="welcome">
      <div class="av" id="av">M</div>
      <div style="flex:1;min-width:0">
        <div class="lbl">BIENVENUE</div>
        <div class="hello" id="hello">chez MI@MI</div>
      </div>
      <span class="pill" id="nbp">… produits</span>
    </div>
    <div class="chips" id="chips"></div>
    <div class="gridp" id="grid"><div class="msg" style="grid-column:1/-1">Chargement du menu…</div></div>
  </div>
</section>

<!-- INFOS -->
<section class="page" id="p-infos"><div class="wrap">
  <div class="head"><div class="hi">ⓘ</div><div class="ht anton">INFOS</div></div>
  <div id="infos"></div>
</div></section>

<!-- PANIER -->
<section class="page" id="p-panier"><div class="wrap">
  <div class="head"><div class="hi">🛒</div><div class="ht anton">MON PANIER</div></div>
  <div id="panier"></div>
</div></section>

<!-- CONTACT -->
<section class="page" id="p-contact"><div class="wrap">
  <div class="head"><div class="hi">✉</div><div class="ht anton">CONTACT</div></div>
  <div id="contact"></div>
</div></section>

<nav id="nav">
  <button type="button" data-p="accueil" class="on"><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg></span>Accueil</button>
  <button type="button" data-p="infos"><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="8" r=".6" fill="currentColor"/></svg></span>Infos</button>
  <button type="button" data-p="panier"><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.5 12h12l2-9H6.2"/></svg></span>Panier<span class="cnt" id="cnt" style="display:none">0</span></button>
  <button type="button" data-p="contact"><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>Contact</button>
</nav>

<div class="sheet" id="sheet"><div class="shade" id="shade"></div><div class="panel" id="panel"></div></div>
<div class="toast" id="toast"></div>

<script>
// ===== Couleurs des catégories (tu peux en ajouter) =====
const COULEURS = { "BURGERS": "#FF8A3D", "À CÔTÉ": "#19E3D0", "BOISSONS": "#FF3E9A", "FORMULE": "#FFE27A", "DESSERTS": "#C9A2FF", "AUTRE": "#C9B8E6" };
// =======================================================

const tg = window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.initData !== undefined ? window.Telegram.WebApp : null;
const dansTelegram = !!(tg && tg.initData);
let PRODUITS = [], INFOS = {}, CAT = "TOUS", MODE = "livraison";
const panier = {};
const $ = id => document.getElementById(id);
const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const dev = () => INFOS.devise || "CHF";
const prix = n => Number(n).toFixed(2) + " " + dev();
const couleur = c => COULEURS[c] || "#19E3D0";
const vibre = (t = "light") => { try { tg && tg.HapticFeedback && tg.HapticFeedback.impactOccurred(t); } catch (e) {} };

function toast(t) {
  const el = $("toast"); el.textContent = t; el.classList.add("on");
  clearTimeout(toast.t); toast.t = setTimeout(() => el.classList.remove("on"), 1600);
}

function media(p, mini) {
  if (p.video && !mini) return `<video src="${esc(p.video)}"${p.photo ? ` poster="${esc(p.photo)}"` : ""} muted loop playsinline autoplay preload="metadata"></video>`;
  if (p.photo) return `<img src="${esc(p.photo)}" alt="${esc(p.nom)}" loading="lazy" onerror="this.outerHTML=window.__ph(this.alt)">`;
  return placeholder(p.nom, p.categorie);
}
function placeholder(nom, cat) {
  const c = couleur(cat);
  const ini = String(nom || "?").replace(/^(le |la |l'|les )/i, "").slice(0, 2).toUpperCase();
  return `<div class="ph anton" style="background:radial-gradient(circle at 50% 120%, ${c}55, transparent 70%), #22103F;color:${c};text-shadow:3px 3px 0 #0D0620">${esc(ini)}</div>`;
}
window.__ph = n => placeholder(n, (PRODUITS.find(p => p.nom === n) || {}).categorie);

// ----- ACCUEIL -----
function rendreAccueil() {
  const cats = ["TOUS", ...new Set(PRODUITS.map(p => p.categorie))];
  $("chips").innerHTML = cats.map(c => `<button type="button" class="chip${c === CAT ? " on" : ""}" data-cat="${esc(c)}">${c === "TOUS" ? "Tout" : esc(c.charAt(0) + c.slice(1).toLowerCase())}</button>`).join("");
  $("nbp").textContent = PRODUITS.length + " produits";
  const liste = CAT === "TOUS" ? PRODUITS : PRODUITS.filter(p => p.categorie === CAT);
  if (!liste.length) { $("grid").innerHTML = `<div class="msg" style="grid-column:1/-1">Aucun produit pour le moment.</div>`; return; }
  $("grid").innerHTML = liste.map(p => {
    const q = panier[p.id] || 0, c = couleur(p.categorie);
    return `<button type="button" class="pc" data-open="${esc(p.id)}">
      <div class="pm">${media(p, true)}<span class="tag" style="color:${c};border-color:${c}">${esc(p.categorie)}</span>${p.video ? `<span class="vid"><svg width="12" height="12" viewBox="0 0 24 24" fill="#fff"><path d="M7 4l13 8-13 8z"/></svg></span>` : ""}</div>
      <div class="pi"><div class="pn">${esc(p.nom)}</div><div class="pd">${esc(p.description)}</div>
      <div class="pb"><span class="pp anton">${prix(p.prix)}</span>${q ? `<span class="qn">×${q}</span>` : `<span class="plus" data-add="${esc(p.id)}">+</span>`}</div></div>
    </button>`;
  }).join("");
}

// ----- FICHE PRODUIT -----
let ficheQ = 1, ficheP = null;
function ouvrirFiche(id) {
  ficheP = PRODUITS.find(p => p.id === id); if (!ficheP) return;
  ficheQ = 1; rendreFiche(); $("sheet").classList.add("on"); vibre();
}
function rendreFiche() {
  const p = ficheP, c = couleur(p.categorie);
  $("panel").innerHTML = `
    <div class="sm">${media(p)}<button type="button" class="close" data-close aria-label="Fermer">✕</button></div>
    <div class="sc">
      <span class="tag" style="position:static;color:${c};border-color:${c}">${esc(p.categorie)}</span>
      <div class="sn anton">${esc(p.nom)}</div>
      <div class="sd">${esc(p.description)}</div>
      <div class="sa"><span class="anton">${prix(p.prix)}</span>
        <div class="step"><button type="button" class="sb m" data-fq="-1" aria-label="Moins">−</button><b style="min-width:22px;text-align:center">${ficheQ}</b><button type="button" class="sb p" data-fq="1" aria-label="Plus">+</button></div></div>
      <button type="button" class="cta full" data-fadd>AJOUTER · ${prix(p.prix * ficheQ)}</button>
    </div>`;
}
function fermerFiche() { $("sheet").classList.remove("on"); $("panel").innerHTML = ""; }

// ----- PANIER -----
function total() { return PRODUITS.reduce((t, p) => t + p.prix * (panier[p.id] || 0), 0); }
function nbArticles() { return Object.values(panier).reduce((a, b) => a + b, 0); }
function ajouter(id, n = 1) {
  panier[id] = Math.max(0, (panier[id] || 0) + n);
  if (!panier[id]) delete panier[id];
  majCompteurs();
}
function majCompteurs() {
  const n = nbArticles();
  $("cnt").style.display = n ? "flex" : "none"; $("cnt").textContent = n;
  rendreAccueil();
  if ($("p-panier").classList.contains("on")) rendrePanier();
  majBoutonTelegram();
}
function rendrePanier() {
  const ids = Object.keys(panier).filter(id => PRODUITS.some(p => p.id === id));
  if (!ids.length) {
    $("panier").innerHTML = `<div class="box empty"><div class="ei"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1 13H7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg></div>
      <div style="font-size:20px;font-weight:800">Ton panier est vide</div>
      <div class="bx" style="margin-bottom:22px">Ajoute des produits pour commander.</div>
      <button type="button" class="cta" data-goto="accueil">Découvrir les produits</button></div>`;
    return;
  }
  const liv = INFOS.livraison && INFOS.livraison.actif !== false, ret = INFOS.retrait && INFOS.retrait.actif !== false;
  if (!liv && MODE === "livraison") MODE = "retrait";
  if (!ret && MODE === "retrait") MODE = "livraison";
  const ancienne = { adr: ($("adr") || {}).value || "", note: ($("note") || {}).value || "" };
  $("panier").innerHTML = ids.map(id => {
    const p = PRODUITS.find(x => x.id === id), q = panier[id];
    return `<div class="line"><div class="lt">${media(p, true)}</div><div class="lx"><div class="ln">${esc(p.nom)}</div><div class="ls">${prix(p.prix * q)}</div></div>
      <div class="step"><button type="button" class="sb m" data-q="${esc(id)}" data-d="-1" aria-label="Retirer">−</button><b style="min-width:18px;text-align:center">${q}</b><button type="button" class="sb p" data-q="${esc(id)}" data-d="1" aria-label="Ajouter">+</button></div></div>`;
  }).join("") + `
    ${liv && ret ? `<div class="toggle"><button type="button" class="tg${MODE === "livraison" ? " on" : ""}" data-mode="livraison">🚚 Livraison</button><button type="button" class="tg${MODE === "retrait" ? " on" : ""}" data-mode="retrait">🏠 Retrait</button></div>` : ""}
    ${MODE === "livraison" ? `<label class="f" for="adr">ADRESSE DE LIVRAISON</label><input class="f" id="adr" placeholder="Rue, numéro, ville" value="${esc(ancienne.adr)}">`
      : `<div class="box" style="margin-top:12px"><div class="bt"><span class="bi">📍</span>Retrait</div><div class="bx">${esc(INFOS.retrait && INFOS.retrait.adresse || "")}</div></div>`}
    <label class="f" for="note">NOTE (OPTIONNEL)</label><textarea class="f" id="note" placeholder="Sans oignons, sonner 2 fois…">${esc(ancienne.note)}</textarea>
    <div class="tot"><span>TOTAL</span><span class="anton">${prix(total())}</span></div>
    <div class="err" id="err"></div>
    <button type="button" class="cta full" data-commander>CONFIRMER LA COMMANDE</button>
    <div class="note">Ta commande s'ouvre dans une discussion avec nous, déjà écrite.<br>Tu n'as plus qu'à appuyer sur Envoyer ✅</div>`;
}

function texteCommande() {
  const lignes = Object.keys(panier).map(id => {
    const p = PRODUITS.find(x => x.id === id); if (!p) return null;
    return `• ${panier[id]}× ${p.nom} — ${prix(p.prix * panier[id])}`;
  }).filter(Boolean);
  const adr = (($("adr") || {}).value || "").trim(), note = (($("note") || {}).value || "").trim();
  return [
    "🛍️ COMMANDE MI@MI",
    "━━━━━━━━━━━━",
    ...lignes,
    "━━━━━━━━━━━━",
    `💰 TOTAL : ${prix(total())}`,
    MODE === "livraison" ? `🚚 Livraison : ${adr}` : "🏠 Retrait sur place",
    note ? `📝 Note : ${note}` : null,
    "",
    "✅ Je confirme ma commande",
  ].filter(x => x !== null).join("\n");
}

function commander() {
  const err = $("err"); if (err) err.textContent = "";
  const min = Number(INFOS.minimum_commande || 0);
  if (total() < min) { if (err) err.textContent = `Minimum de commande : ${prix(min)}`; vibre("medium"); return; }
  if (MODE === "livraison" && $("adr") && !$("adr").value.trim()) { err.textContent = "Ajoute ton adresse de livraison."; $("adr").focus(); return; }
  const vendeur = String((INFOS.contact && INFOS.contact.telegram) || "").replace(/^@/, "").trim();
  if (!vendeur) { err.textContent = "Contact Telegram du vendeur manquant (infos.json)."; return; }
  const lien = `https://t.me/${encodeURIComponent(vendeur)}?text=${encodeURIComponent(texteCommande())}`;
  try { tg && tg.HapticFeedback && tg.HapticFeedback.notificationOccurred("success"); } catch (e) {}
  if (dansTelegram && tg.openTelegramLink) tg.openTelegramLink(lien); else window.open(lien, "_blank");
  toast("Message prêt, appuie sur Envoyer ✅");
}

function majBoutonTelegram() {
  if (!dansTelegram || !tg.MainButton) return;
  const surPanier = $("p-panier").classList.contains("on");
  if (nbArticles() && !surPanier) {
    tg.MainButton.setParams({ text: `VOIR LE PANIER · ${prix(total())}`, color: "#FF3E9A", text_color: "#FFFFFF" }); tg.MainButton.show();
  } else tg.MainButton.hide();
}

// ----- INFOS / CONTACT -----
function rendreInfos() {
  const L = INFOS.livraison || {}, R = INFOS.retrait || {}, min = Number(INFOS.minimum_commande || 0);
  let h = "";
  if (L.actif !== false && (L.texte || L.frais)) h += `<div class="box"><div class="bt"><span class="bi">🚚</span>Livraison</div><div class="bx">${esc(L.texte || "")}${L.frais ? `<br>${esc(L.frais)}` : ""}</div>${min ? `<div class="right"><span class="pill">Minimum ${prix(min)}</span></div>` : ""}</div>`;
  if (R.actif !== false && (R.adresse || R.texte)) h += `<div class="box"><div class="bt"><span class="bi">🏠</span>Retrait</div><div class="row"><span>📍 ${esc(R.adresse || "")}</span><span>Disponible</span></div>${R.texte ? `<div class="bx">${esc(R.texte)}</div>` : ""}</div>`;
  if ((INFOS.horaires || []).length) h += `<div class="box"><div class="bt"><span class="bi">🕐</span>Horaires</div>${INFOS.horaires.map(x => `<div class="row"><span>${esc(x.jours)}</span><span>${esc(x.heures)}</span></div>`).join("")}</div>`;
  if (INFOS.paiement) h += `<div class="box"><div class="bt"><span class="bi">💳</span>Paiement</div><div class="bx">${esc(INFOS.paiement)}</div></div>`;
  $("infos").innerHTML = h || `<div class="msg">Infos bientôt disponibles.</div>`;
}
function rendreContact() {
  const C = INFOS.contact || {}, items = [];
  if (C.telegram) items.push(["TELEGRAM", "#19E3D0", "@" + String(C.telegram).replace(/^@/, ""), "https://t.me/" + String(C.telegram).replace(/^@/, "")]);
  if (C.instagram) items.push(["INSTAGRAM", "#FF3E9A", "@" + String(C.instagram).replace(/^@/, ""), "https://instagram.com/" + String(C.instagram).replace(/^@/, "")]);
  if (C.snapchat) items.push(["SNAPCHAT", "#FFE27A", String(C.snapchat), "https://snapchat.com/add/" + String(C.snapchat).replace(/^@/, "")]);
  if (C.telephone) items.push(["TÉLÉPHONE", "#FF8A3D", String(C.telephone), "tel:" + String(C.telephone).replace(/\s/g, "")]);
  $("contact").innerHTML = items.map(([t, c, v, u]) => `<button type="button" class="cl" data-link="${esc(u)}"><span class="bi" style="color:${c};border-color:${c}55;background:${c}14">●</span><span><small style="color:${c}">${t}</small><b>${esc(v)}</b></span><span class="go">↗</span></button>`).join("")
    || `<div class="msg">Contacts bientôt disponibles.</div>`;
}

// ----- NAVIGATION -----
function aller(p) {
  document.querySelectorAll(".page").forEach(s => s.classList.toggle("on", s.id === "p-" + p));
  document.querySelectorAll("nav button").forEach(b => b.classList.toggle("on", b.dataset.p === p));
  if (p === "panier") rendrePanier();
  window.scrollTo(0, p === "accueil" && aller.dejaVu ? $("catalogue").offsetTop - 10 : 0);
  if (p === "accueil") aller.dejaVu = true;
  majBoutonTelegram(); vibre();
}

document.addEventListener("click", e => {
  const t = e.target.closest("[data-p],[data-cat],[data-add],[data-open],[data-close],[data-fq],[data-fadd],[data-q],[data-mode],[data-commander],[data-goto],[data-link]");
  if (!t) { if (e.target.id === "shade") fermerFiche(); return; }
  const d = t.dataset;
  if (d.p) return aller(d.p);
  if (d.goto) return aller(d.goto);
  if (d.cat) { CAT = d.cat; vibre(); return rendreAccueil(); }
  if (d.add) { e.stopPropagation(); ajouter(d.add); vibre(); return toast("Ajouté au panier"); }
  if (d.open) return ouvrirFiche(d.open);
  if (d.close !== undefined) return fermerFiche();
  if (d.fq) { ficheQ = Math.max(1, ficheQ + Number(d.fq)); vibre(); return rendreFiche(); }
  if (d.fadd !== undefined) { ajouter(ficheP.id, ficheQ); fermerFiche(); vibre("medium"); return toast(`${ficheQ}× ajouté au panier`); }
  if (d.q) { ajouter(d.q, Number(d.d)); vibre(); return; }
  if (d.mode) { MODE = d.mode; vibre(); return rendrePanier(); }
  if (d.commander !== undefined) return commander();
  if (d.link) { if (dansTelegram && d.link.startsWith("https://t.me/")) tg.openTelegramLink(d.link); else if (dansTelegram && d.link.startsWith("http")) tg.openLink(d.link); else window.open(d.link, "_blank"); }
});
$("go-explorer").addEventListener("click", () => { $("catalogue").scrollIntoView({ behavior: "smooth" }); vibre(); });
$("shade").addEventListener("click", fermerFiche);

// ----- Billets qui tombent -----
(function () {
  const billet = `<svg width="56" height="26" viewBox="0 0 70 32"><rect x="1" y="1" width="68" height="30" rx="3" fill="#9BE3A8" stroke="#0E5A2C" stroke-width="2"/><circle cx="35" cy="16" r="9" fill="none" stroke="#0E5A2C" stroke-width="2"/><text x="35" y="21" text-anchor="middle" font-size="13" font-weight="800" fill="#0E5A2C" font-family="sans-serif">$</text></svg>`;
  let h = "";
  for (let i = 0; i < 9; i++) h += `<div class="bill" style="left:${Math.round(Math.random() * 92)}%;animation-duration:${(7 + Math.random() * 6).toFixed(1)}s;animation-delay:-${(Math.random() * 10).toFixed(1)}s;transform:scale(${(0.6 + Math.random() * 0.6).toFixed(2)})">${billet}</div>`;
  $("bills").innerHTML = h;
})();

// ----- Démarrage -----
if (dansTelegram) {
  tg.ready(); tg.expand();
  try { tg.setHeaderColor("#160A2E"); tg.setBackgroundColor("#160A2E"); } catch (e) {}
  try { tg.disableVerticalSwipes && tg.disableVerticalSwipes(); } catch (e) {}
  tg.MainButton.onClick(() => aller("panier"));
  const u = tg.initDataUnsafe && tg.initDataUnsafe.user;
  if (u && u.first_name) { $("hello").textContent = u.first_name; $("av").textContent = u.first_name.charAt(0).toUpperCase(); }
}

async function charger() {
  try { INFOS = await (await fetch("infos.json?v=" + Date.now())).json(); } catch (e) { INFOS = {}; }
  rendreInfos(); rendreContact();
  let liste = null;
  if (INFOS.bot_url) {
    try {
      const r = await fetch(INFOS.bot_url.replace(/\/$/, "") + "/produits?v=" + Date.now());
      if (r.ok) liste = await r.json();
    } catch (e) {}
  }
  if (!Array.isArray(liste)) {
    try { liste = await (await fetch("produits.json?v=" + Date.now())).json(); } catch (e) { liste = []; }
  }
  PRODUITS = liste.filter(p => p && p.id && p.nom && p.dispo !== false).map(p => ({ ...p, prix: Number(p.prix) || 0, categorie: String(p.categorie || "AUTRE").toUpperCase() }));
  rendreAccueil();
}
charger();
</script>
</body>
